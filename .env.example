APP_ENV=development
APP_NAME=AI Financial Literacy Advisor
DATABASE_URL=postgresql://finance_user:finance_password@db:5432/finance_db
JWT_SECRET_KEY=replace_with_a_secure_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# SMTP account used to deliver one-time email verification codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
EMAIL_VERIFICATION_TTL_SECONDS=600
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5

# Select a provider and set only its key in the untracked local .env file.
LLM_PROVIDER=openrouter
GEMINI_API_KEY=
OPENROUTER_API_KEY=
LLM_MODEL=google/gemini-2.5-flash
LLM_TIMEOUT_SECONDS=15
LLM_TEMPERATURE=0.3
LLM_STRUCTURED_TEMPERATURE=0
LLM_RETRY_ATTEMPTS=1
LLM_RETRY_DELAY_SECONDS=0.75

CHAT_CONTEXT_MAX_MESSAGES=16
CHAT_CONTEXT_MAX_MESSAGE_CHARACTERS=1200
GOAL_CONTEXT_MAX_MESSAGES=96
GOAL_CONTEXT_MAX_MESSAGE_CHARACTERS=400
PDF_CONTEXT_MAX_CHARACTERS=6000

GOAL_PRIORITY_HIGH_WEIGHT=3
GOAL_PRIORITY_MEDIUM_WEIGHT=2
GOAL_PRIORITY_LOW_WEIGHT=1
RULE_INTENT_CONFIDENCE_THRESHOLD=0.55

UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10

# Local development administrator seed (do not use these values in production).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
ADMIN_NAME=Admin
